# .env — Variáveis de ambiente do HackerHero Guardian
# Renomeie este arquivo para .env e preencha os valores reais

# --- Chave da API OpenAI (obrigatória para o Agente de IA) ---
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# --- Modelo OpenAI (padrão: gpt-4o-mini) ---
OPENAI_MODEL=gpt-4o-mini

# --- Intervalo de captura de tela em segundos (padrão: 5) ---
CAPTURE_INTERVAL_SECONDS=5

# --- Intervalo de análise da IA em segundos (padrão: 30) ---
AI_ANALYSIS_INTERVAL_SECONDS=30

# --- Ativar GPU no EasyOCR (True/False) ---
OCR_GPU=False

# --- E-mail dos pais para notificações (opcional) ---
ALERT_EMAIL=pais@email.com

# --- Debug mode ---
DEBUG=False
